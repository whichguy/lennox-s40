#!/usr/bin/env bash
# Lennox S40 local LAN CLI — resolve Python + lennoxs30api, then run lennox_s40.py
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: lennox-s40 [--setup] [--] [cli args...]

Commands: version | config | discover | status | mode | cool | heat | fan | away | hold
  lennox-s40 discover
  lennox-s40 --ip 192.168.1.10 status
  lennox-s40 cool 76 --zone Downstairs
  lennox-s40 hold off --zone Downstairs

Environment:
  LENNOX_IP       Thermostat IP or mDNS name (else config / discover)
  LENNOX_APP_ID   Optional client id (else unique install-scoped id in config)
  LENNOX_PYTHON   Python interpreter override
  LENNOX_VENV     Venv directory (default: $XDG_DATA_HOME/lennox-s40/venv
                  or ~/.local/share/lennox-s40/venv)
  LENNOX_CONFIG   Running config path (default ~/.config/lennox-s40/config.json)

  --setup         Create venv and pip install requirements.txt, then exit 0
EOF
}

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
py_script="$here/lennox_s40.py"
req="$here/../requirements.txt"
[[ -f "$py_script" ]] || { printf 'lennox-s40: missing %s\n' "$py_script" >&2; exit 2; }

data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
venv_dir="${LENNOX_VENV:-$data_home/lennox-s40/venv}"

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

do_setup=0
if [[ "${1:-}" == "--setup" ]]; then
  do_setup=1
  shift
fi
if [[ "${1:-}" == "--" ]]; then
  shift
fi

pick_bootstrap_python() {
  if [[ -n "${LENNOX_PYTHON:-}" ]]; then
    printf '%s\n' "$LENNOX_PYTHON"
    return 0
  fi
  if command -v python3 >/dev/null 2>&1; then
    command -v python3
    return 0
  fi
  return 1
}

ensure_venv() {
  local boot
  boot="$(pick_bootstrap_python)" || {
    printf 'lennox-s40: python3 not found (set LENNOX_PYTHON)\n' >&2
    exit 2
  }
  if [[ ! -x "$venv_dir/bin/python" ]]; then
    mkdir -p "$(dirname "$venv_dir")"
    "$boot" -m venv "$venv_dir"
  fi
  # shellcheck disable=SC1091
  # install deps
  "$venv_dir/bin/pip" install -q -U pip
  if [[ -f "$req" ]]; then
    "$venv_dir/bin/pip" install -q -r "$req"
  else
    "$venv_dir/bin/pip" install -q lennoxs30api aiohttp pytz
  fi
}

python_ready() {
  local py="$1"
  "$py" -c 'import lennoxs30api, aiohttp, pytz' >/dev/null 2>&1
}

resolve_python() {
  if [[ -n "${LENNOX_PYTHON:-}" ]] && python_ready "$LENNOX_PYTHON"; then
    printf '%s\n' "$LENNOX_PYTHON"
    return 0
  fi
  if [[ -x "$venv_dir/bin/python" ]] && python_ready "$venv_dir/bin/python"; then
    printf '%s\n' "$venv_dir/bin/python"
    return 0
  fi
  if command -v python3 >/dev/null 2>&1 && python_ready "$(command -v python3)"; then
    command -v python3
    return 0
  fi
  return 1
}

if [[ "$do_setup" -eq 1 ]]; then
  ensure_venv
  printf 'lennox-s40: ready (venv %s)\n' "$venv_dir"
  exit 0
fi

# Dep-free subcommands: use any python3 (do not require lennoxs30api).
# Constraint: works with empty LENNOX_VENV and on CI.
is_depfree_dispatch() {
  case "${1:-}" in
    -h|--help|--version) return 0 ;;
    version|config) return 0 ;;
  esac
  # Leading globals then version/config/--help/--version
  local a skip_next=0
  for a in "$@"; do
    if [[ "$skip_next" -eq 1 ]]; then
      skip_next=0
      continue
    fi
    case "$a" in
      -h|--help|--version) return 0 ;;
      --)
        continue
        ;;
      --ip|--app-id|--zone)
        # value-taking flags — skip the next token
        skip_next=1
        continue
        ;;
      --full|--first-zone|--lan-scan|--no-lan-scan|--no-rediscover|--probe-only)
        continue
        ;;
      -*)
        continue
        ;;
      version|config) return 0 ;;
      *) return 1 ;;
    esac
  done
  return 1
}

boot_py="$(pick_bootstrap_python)" || {
  printf 'lennox-s40: python3 not found (set LENNOX_PYTHON)\n' >&2
  exit 2
}

if is_depfree_dispatch "$@"; then
  # Bootstrap interpreter only — no venv/deps required
  exec "$boot_py" "$py_script" "$@"
fi

py=""
if ! py="$(resolve_python)"; then
  printf 'lennox-s40: lennoxs30api not importable. Run once:\n' >&2
  printf '  %s --setup\n' "$0" >&2
  printf 'Or: pip install -r %s\n' "$req" >&2
  exit 2
fi

exec "$py" "$py_script" "$@"
